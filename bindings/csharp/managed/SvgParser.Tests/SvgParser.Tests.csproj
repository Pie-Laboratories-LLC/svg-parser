<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- PieLaboratories.Svg.Path otherwise collides with System.IO.Path (from ImplicitUsings). -->
    <Using Include="PieLaboratories.Svg.Path" Alias="Path" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvgParser\SvgParser.csproj" />
  </ItemGroup>

  <Target Name="PrintOS" BeforeTargets="Build">
    <Message Importance="high" Text="OS is: $(OS)" />
  </Target>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../../../build/bindings/csharp/native/libsvgparser_c.so"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libsvgparser_c.so</Link>
    </None>
    <None Include="$(MSBuildProjectDirectory)/../../../../build/bindings/csharp/native/libsvgparser_c.dll"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>svgparser_c.dll</Link>
    </None>
  </ItemGroup>

</Project>
